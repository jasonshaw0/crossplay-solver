{
  "name": "crossplay-solver",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "npm run dictionary:prepare && next build",
    "lint": "eslint .",
